# Copy this file to `.env` and put your key in it, then rebuild.
#
# CARTO gives basemap keys away free: fill in the form at
# https://carto.com/basemaps/apikey and it is emailed straight back. No CARTO
# account, no credit card, no approval queue. The free tier is 5 million tile
# requests a month — a single run of DEADRUN uses a few hundred.
#
# Without a key the map still works and the game is unaffected, but every tile
# arrives with "API KEY REQUIRED" printed across it.
EXPO_PUBLIC_CARTO_KEY=
